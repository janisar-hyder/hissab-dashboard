generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperAdminRole {
  id            Int                        @id @default(autoincrement())
  name          String                     @unique @db.VarChar(100)
  status        String?                    @default("Active") @db.VarChar(50)
  created_date  DateTime                   @default(now())
  created_by    Int?
  updated_date  DateTime                   @default(now()) @updatedAt
  updated_by    Int?
  permissions   SuperAdminRolePermission[]
  createdByUser SuperAdminUser?            @relation("RoleCreatedBy", fields: [created_by], references: [id])
  updatedByUser SuperAdminUser?            @relation("RoleUpdatedBy", fields: [updated_by], references: [id])
  users         SuperAdminUser[]           @relation("Role")

  @@map("super_admin_roles")
}

model SuperAdminRolePermission {
  id            Int             @id @default(autoincrement())
  role_id       Int
  module_name   String          @db.VarChar(150)
  can_create    Boolean?        @default(false)
  can_view      Boolean?        @default(true)
  can_update    Boolean?        @default(false)
  can_delete    Boolean?        @default(false)
  created_date  DateTime        @default(now())
  created_by    Int?
  updated_date  DateTime        @default(now()) @updatedAt
  updated_by    Int?
  createdByUser SuperAdminUser? @relation("PermCreatedBy", fields: [created_by], references: [id])
  role          SuperAdminRole  @relation(fields: [role_id], references: [id], onDelete: Cascade)
  updatedByUser SuperAdminUser? @relation("PermUpdatedBy", fields: [updated_by], references: [id])

  @@map("super_admin_role_permissions")
}

model SuperAdminUser {
  id                     Int                        @id @default(autoincrement())
  name                   String                     @db.VarChar(255)
  email                  String                     @unique @db.VarChar(255)
  password_hash          String                     @db.VarChar(255)
  role_id                Int?
  status                 String?                    @default("Active") @db.VarChar(50)
  created_date           DateTime                   @default(now())
  created_by             Int?
  updated_date           DateTime                   @default(now()) @updatedAt
  updated_by             Int?
  managedClients         Client[]                   @relation("AccountManager")
  createdClients         Client[]                   @relation("ClientCreatedBy")
  updatedClients         Client[]                   @relation("ClientUpdatedBy")
  createdPermissions     SuperAdminRolePermission[] @relation("PermCreatedBy")
  updatedPermissions     SuperAdminRolePermission[] @relation("PermUpdatedBy")
  createdRoles           SuperAdminRole[]           @relation("RoleCreatedBy")
  updatedRoles           SuperAdminRole[]           @relation("RoleUpdatedBy")
  createdByUser          SuperAdminUser?            @relation("SelfCreatedBy", fields: [created_by], references: [id])
  createdSuperAdminUsers SuperAdminUser[]           @relation("SelfCreatedBy")
  role                   SuperAdminRole?            @relation("Role", fields: [role_id], references: [id])
  updatedByUser          SuperAdminUser?            @relation("SelfUpdatedBy", fields: [updated_by], references: [id])
  updatedSuperAdminUsers SuperAdminUser[]           @relation("SelfUpdatedBy")

  @@map("super_admin_users")
}

model Client {
  id                      Int                      @id @default(autoincrement())
  client_num              String                   @unique @db.VarChar(50)
  name                    String                   @db.VarChar(255)
  cr_num                  String                   @db.VarChar(100)
  email                   String?                  @db.VarChar(255)
  phone                   String?                  @db.VarChar(50)
  mobile                  String?                  @db.VarChar(50)
  account_manager_id      Int?
  billing_cycle           String?                  @db.VarChar(50)
  sub_model               String?                  @db.VarChar(50)
  num_users               Int?                     @default(1)
  sub_start_date          DateTime?                @db.Date
  sub_end_date            DateTime?                @db.Date
  hosting                 String?                  @db.VarChar(50)
  amount                  Decimal?                 @db.Decimal(18, 3)
  annual_maintenance_cost Decimal?                 @db.Decimal(18, 3)
  cloud_charges           Decimal?                 @db.Decimal(18, 3)
  default_language        String?                  @default("English") @db.VarChar(50)
  time_zone               String?                  @default("UTC+3:00") @db.VarChar(100)
  date_format             String?                  @db.VarChar(50)
  time_format             String?                  @db.VarChar(50)
  base_currency           String?                  @default("BHD") @db.VarChar(10)
  currency_format         String?                  @db.VarChar(50)
  logo_path               String?                  @db.VarChar(512)
  client_admin_username   String                   @db.VarChar(255)
  client_admin_password   String                   @db.VarChar(255)
  remarks                 String?
  is_active               Boolean?                 @default(true)
  deleted_at              DateTime?
  created_date            DateTime                 @default(now())
  created_by              Int?
  updated_date            DateTime                 @default(now()) @updatedAt
  updated_by              Int?
  chartOfAccounts         ChartOfAccount[]
  clientContacts          ClientContact[]
  currencies              Currency[]
  permissions             ClientPermission[]
  clientRoles             ClientRole[]
  clientUsers             ClientUser[]
  accountManager          SuperAdminUser?          @relation("AccountManager", fields: [account_manager_id], references: [id])
  createdByUser           SuperAdminUser?          @relation("ClientCreatedBy", fields: [created_by], references: [id])
  updatedByUser           SuperAdminUser?          @relation("ClientUpdatedBy", fields: [updated_by], references: [id])
  companyProfile          CompanyProfile?
  customers               Customer[]
  categories              InventoryCategory[]
  inventoryItems          InventoryItem[]
  subCategories           InventorySubCategory[]
  uoms                    InventoryUnitOfMeasure[]
  invoices                Invoice[]
  purchaseVendors         PurchaseVendor[]
  quotations              Quotation[]
  salesPartners           SalesPartner[]
  salesPersons            SalesPerson[]
  vatRates                VatRate[]
  vatSettings             VatSetting?
  recurringInvoices       RecurringInvoice[]
  deliveryNotes           DeliveryNote[]
  receipts                Receipt[]
  creditNotes             CreditNote[]
  salesModuleSettings     SalesModuleSettings[]
  columnPreferences       UserColumnPreference[]

  @@map("clients")
}

model ClientRole {
  id            Int                    @id @default(autoincrement())
  client_id     Int
  name          String                 @db.VarChar(100)
  status        String?                @default("Active") @db.VarChar(50)
  created_date  DateTime               @default(now())
  created_by    Int?
  updated_date  DateTime               @default(now()) @updatedAt
  updated_by    Int?
  permissions   ClientRolePermission[]
  client        Client                 @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser ClientUser?            @relation("CRoleCreatedBy", fields: [created_by], references: [id])
  updatedByUser ClientUser?            @relation("CRoleUpdatedBy", fields: [updated_by], references: [id])
  users         ClientUser[]           @relation("UserRole")

  @@unique([client_id, name])
  @@map("client_roles")
}

model ClientRolePermission {
  id           Int        @id @default(autoincrement())
  role_id      Int
  module_name  String     @db.VarChar(150)
  can_create   Boolean?   @default(false)
  can_view     Boolean?   @default(true)
  can_update   Boolean?   @default(false)
  can_delete   Boolean?   @default(false)
  created_date DateTime   @default(now())
  created_by   Int?
  updated_date DateTime   @default(now()) @updatedAt
  updated_by   Int?
  role         ClientRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@map("client_role_permissions")
}

model ClientUser {
  id                       Int                      @id @default(autoincrement())
  client_id                Int
  name                     String                   @db.VarChar(255)
  email                    String                   @db.VarChar(255)
  password_hash            String                   @db.VarChar(255)
  role_id                  Int?
  status                   String?                  @default("Active") @db.VarChar(50)
  created_date             DateTime                 @default(now())
  created_by               Int?
  updated_date             DateTime                 @default(now()) @updatedAt
  updated_by               Int?
  createdCOAs              ChartOfAccount[]         @relation("COACreatedBy")
  updatedCOAs              ChartOfAccount[]         @relation("COAUpdatedBy")
  createdCContacts         ClientContact[]          @relation("CContactCreatedBy")
  updatedCContacts         ClientContact[]          @relation("CContactUpdatedBy")
  createdCurrencies        Currency[]               @relation("CurrencyCreatedBy")
  updatedCurrencies        Currency[]               @relation("CurrencyUpdatedBy")
  createdCPerms            ClientPermission[]       @relation("CPermCreatedBy")
  updatedCPerms            ClientPermission[]       @relation("CPermUpdatedBy")
  createdCRoles            ClientRole[]             @relation("CRoleCreatedBy")
  updatedCRoles            ClientRole[]             @relation("CRoleUpdatedBy")
  client                   Client                   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser            ClientUser?              @relation("SelfCUserCreatedBy", fields: [created_by], references: [id])
  createdClientUsers       ClientUser[]             @relation("SelfCUserCreatedBy")
  role                     ClientRole?              @relation("UserRole", fields: [role_id], references: [id])
  updatedByUser            ClientUser?              @relation("SelfCUserUpdatedBy", fields: [updated_by], references: [id])
  updatedClientUsers       ClientUser[]             @relation("SelfCUserUpdatedBy")
  updatedCompanyProfiles   CompanyProfile[]         @relation("CompProfUpdatedBy")
  createdCustContacts      CustomerContact[]        @relation("CustContCreatedBy")
  updatedCustContacts      CustomerContact[]        @relation("CustContUpdatedBy")
  createdCustomers         Customer[]               @relation("CustCreatedBy")
  deletedCustomers         Customer[]               @relation("CustDeletedBy")
  updatedCustomers         Customer[]               @relation("CustUpdatedBy")
  createdCategories        InventoryCategory[]      @relation("CatCreatedBy")
  updatedCategories        InventoryCategory[]      @relation("CatUpdatedBy")
  createdItems             InventoryItem[]          @relation("ItemCreatedBy")
  deletedItems             InventoryItem[]          @relation("ItemDeletedBy")
  updatedItems             InventoryItem[]          @relation("ItemUpdatedBy")
  createdSubCats           InventorySubCategory[]   @relation("SubCatCreatedBy")
  updatedSubCats           InventorySubCategory[]   @relation("SubCatUpdatedBy")
  createdUOMs              InventoryUnitOfMeasure[] @relation("UOMCreatedBy")
  updatedUOMs              InventoryUnitOfMeasure[] @relation("UOMUpdatedBy")
  createdInvDetails        InvoiceDetail[]          @relation("IDetCreatedBy")
  updatedInvDetails        InvoiceDetail[]          @relation("IDetUpdatedBy")
  createdRecurringInvoices RecurringInvoice[]       @relation("RecInvCreatedBy")
  updatedRecurringInvoices RecurringInvoice[]       @relation("RecInvUpdatedBy")
  deletedRecurringInvoices RecurringInvoice[]       @relation("RecInvDeletedBy")
  createdRecInvDetails     RecurringInvoiceDetail[] @relation("RIDetCreatedBy")
  updatedRecInvDetails     RecurringInvoiceDetail[] @relation("RIDetUpdatedBy")
  createdDeliveryNotes     DeliveryNote[]           @relation("DNoteCreatedBy")
  updatedDeliveryNotes     DeliveryNote[]           @relation("DNoteUpdatedBy")
  deletedDeliveryNotes     DeliveryNote[]           @relation("DNoteDeletedBy")
  createdDNoteDetails      DeliveryNoteDetail[]     @relation("DNDetCreatedBy")
  updatedDNoteDetails      DeliveryNoteDetail[]     @relation("DNDetUpdatedBy")
  createdReceipts          Receipt[]                @relation("ReceiptCreatedBy")
  updatedReceipts          Receipt[]                @relation("ReceiptUpdatedBy")
  deletedReceipts          Receipt[]                @relation("ReceiptDeletedBy")
  createdCreditNotes       CreditNote[]             @relation("CreditNoteCreatedBy")
  updatedCreditNotes       CreditNote[]             @relation("CreditNoteUpdatedBy")
  deletedCreditNotes       CreditNote[]             @relation("CreditNoteDeletedBy")
  createdCreditNoteDetails CreditNoteDetail[]       @relation("CNDetCreatedBy")
  updatedCreditNoteDetails CreditNoteDetail[]       @relation("CNDetUpdatedBy")
  createdInvoices          Invoice[]                @relation("InvCreatedBy")
  deletedInvoices          Invoice[]                @relation("InvDeletedBy")
  updatedInvoices          Invoice[]                @relation("InvUpdatedBy")
  createdVContacts         PurchaseVendorContact[]  @relation("VContactCreatedBy")
  updatedVContacts         PurchaseVendorContact[]  @relation("VContactUpdatedBy")
  createdVendors           PurchaseVendor[]         @relation("VendorCreatedBy")
  deletedVendors           PurchaseVendor[]         @relation("VendorDeletedBy")
  updatedVendors           PurchaseVendor[]         @relation("VendorUpdatedBy")
  createdQuotDetails       QuotationDetail[]        @relation("QDetCreatedBy")
  updatedQuotDetails       QuotationDetail[]        @relation("QDetUpdatedBy")
  createdQuotations        Quotation[]              @relation("QuotCreatedBy")
  deletedQuotations        Quotation[]              @relation("QuotDeletedBy")
  updatedQuotations        Quotation[]              @relation("QuotUpdatedBy")
  createdSalesPartners     SalesPartner[]           @relation("SalesPartnerCreatedBy")
  updatedSalesPartners     SalesPartner[]           @relation("SalesPartnerUpdatedBy")
  createdSalesPersons      SalesPerson[]            @relation("SalesPersonCreatedBy")
  updatedSalesPersons      SalesPerson[]            @relation("SalesPersonUpdatedBy")
  createdVatRates          VatRate[]                @relation("VatRateCreatedBy")
  updatedVatRates          VatRate[]                @relation("VatRateUpdatedBy")
  updatedVatSettings       VatSetting[]             @relation("VatSettUpdatedBy")
  columnPreferences        UserColumnPreference[]

  @@unique([client_id, email])
  @@map("client_users")
}

model UserColumnPreference {
  id            Int        @id @default(autoincrement())
  client_id     Int
  user_id       Int
  page_id       String     @db.VarChar(100)
  columns       Json
  created_date  DateTime   @default(now())
  updated_date  DateTime   @default(now()) @updatedAt

  client        Client     @relation(fields: [client_id], references: [id], onDelete: Cascade)
  user          ClientUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([client_id, user_id, page_id])
  @@map("user_column_preferences")
}

model ClientContact {
  id            Int         @id @default(autoincrement())
  client_id     Int
  first_name    String?     @db.VarChar(100)
  last_name     String?     @db.VarChar(100)
  email         String?     @db.VarChar(255)
  phone         String?     @db.VarChar(50)
  designation   String?     @db.VarChar(150)
  created_date  DateTime    @default(now())
  created_by    Int?
  updated_date  DateTime    @default(now()) @updatedAt
  updated_by    Int?
  client        Client      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser ClientUser? @relation("CContactCreatedBy", fields: [created_by], references: [id])
  updatedByUser ClientUser? @relation("CContactUpdatedBy", fields: [updated_by], references: [id])

  @@map("client_contacts")
}

model ClientPermission {
  id            Int         @id @default(autoincrement())
  client_id     Int
  module_name   String      @db.VarChar(150)
  can_create    Boolean?    @default(false)
  can_view      Boolean?    @default(true)
  can_update    Boolean?    @default(false)
  can_delete    Boolean?    @default(false)
  created_date  DateTime    @default(now())
  created_by    Int?
  updated_date  DateTime    @default(now()) @updatedAt
  updated_by    Int?
  client        Client      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser ClientUser? @relation("CPermCreatedBy", fields: [created_by], references: [id])
  updatedByUser ClientUser? @relation("CPermUpdatedBy", fields: [updated_by], references: [id])

  @@map("client_permissions")
}

model ChartOfAccount {
  id                Int                @id @default(autoincrement())
  client_id         Int
  name              String             @db.VarChar(255)
  type              String             @db.VarChar(100)
  parent_id         Int?
  description       String?
  status            String?            @default("Active") @db.VarChar(50)
  created_date      DateTime           @default(now())
  created_by        Int?
  updated_date      DateTime           @default(now()) @updatedAt
  updated_by        Int?
  client            Client             @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser     ClientUser?        @relation("COACreatedBy", fields: [created_by], references: [id])
  parent            ChartOfAccount?    @relation("COAParent", fields: [parent_id], references: [id], onDelete: Cascade)
  children          ChartOfAccount[]   @relation("COAParent")
  updatedByUser     ClientUser?        @relation("COAUpdatedBy", fields: [updated_by], references: [id])
  inventoryItems    InventoryItem[]    @relation("InventoryAccount")
  recurringInvoices RecurringInvoice[] @relation("ReceivableAccount")
  receipts          Receipt[]          @relation("DepositAccount")
  purchaseItems     InventoryItem[]    @relation("PurchaseAccount")
  salesItems        InventoryItem[]    @relation("SalesAccount")

  @@unique([client_id, name])
  @@map("chart_of_accounts")
}

model PurchaseVendor {
  id                         Int                     @id @default(autoincrement())
  client_id                  Int
  name                       String                  @db.VarChar(255)
  type                       String?                 @db.VarChar(50)
  primary_contact            String?                 @db.VarChar(255)
  email                      String?                 @db.VarChar(255)
  phone                      String?                 @db.VarChar(50)
  tax_treatment              String?                 @db.VarChar(100)
  opening_balance            Decimal?                @default(0.000) @db.Decimal(18, 3)
  payment_terms              String?                 @db.VarChar(100)
  remarks                    String?
  status                     String?                 @default("Active") @db.VarChar(50)
  is_active                  Boolean?                @default(true)
  created_date               DateTime                @default(now())
  created_by                 Int?
  updated_date               DateTime                @default(now()) @updatedAt
  updated_by                 Int?
  currency_id                Int?
  billing_address_attention  String?                 @db.VarChar(255)
  billing_address_city       String?                 @db.VarChar(100)
  billing_address_country    String?                 @db.VarChar(100)
  billing_address_details    String?
  deleted_by                 Int?
  deleted_date               DateTime?
  shipment_address_attention String?                 @db.VarChar(255)
  shipment_address_city      String?                 @db.VarChar(100)
  shipment_address_country   String?                 @db.VarChar(100)
  shipment_address_details   String?
  items                      InventoryItem[]
  contacts                   PurchaseVendorContact[]
  client                     Client                  @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser              ClientUser?             @relation("VendorCreatedBy", fields: [created_by], references: [id])
  currency                   Currency?               @relation(fields: [currency_id], references: [id])
  deletedByUser              ClientUser?             @relation("VendorDeletedBy", fields: [deleted_by], references: [id])
  updatedByUser              ClientUser?             @relation("VendorUpdatedBy", fields: [updated_by], references: [id])

  @@map("purchase_vendors")
}

model SalesModuleSettings {
  id            Int      @id @default(autoincrement())
  client_id     Int
  client        Client   @relation(fields: [client_id], references: [id])
  module        String   @db.VarChar(50) // 'quotation', 'invoice', etc.
  default_note  String?  @db.Text
  default_terms String?  @db.Text

  created_by    Int?
  created_date  DateTime @default(now())
  updated_by    Int?
  updated_date  DateTime @default(now()) @updatedAt

  @@unique([client_id, module])
  @@map("sales_module_settings")
}

model PurchaseVendorContact {
  id            Int            @id @default(autoincrement())
  vendor_id     Int
  salutation    String?        @db.VarChar(20)
  first_name    String?        @db.VarChar(100)
  last_name     String?        @db.VarChar(100)
  email         String?        @db.VarChar(255)
  phone         String?        @db.VarChar(50)
  designation   String?        @db.VarChar(150)
  created_date  DateTime       @default(now())
  created_by    Int?
  updated_date  DateTime       @default(now()) @updatedAt
  updated_by    Int?
  createdByUser ClientUser?    @relation("VContactCreatedBy", fields: [created_by], references: [id])
  updatedByUser ClientUser?    @relation("VContactUpdatedBy", fields: [updated_by], references: [id])
  vendor        PurchaseVendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@map("purchase_vendor_contacts")
}

model InventoryCategory {
  id            Int                    @id @default(autoincrement())
  client_id     Int
  name          String                 @db.VarChar(255)
  description   String?
  status        String?                @default("Active") @db.VarChar(50)
  created_date  DateTime               @default(now())
  created_by    Int?
  updated_date  DateTime               @default(now()) @updatedAt
  updated_by    Int?
  client        Client                 @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser ClientUser?            @relation("CatCreatedBy", fields: [created_by], references: [id])
  updatedByUser ClientUser?            @relation("CatUpdatedBy", fields: [updated_by], references: [id])
  items         InventoryItem[]
  subCategories InventorySubCategory[]

  @@unique([client_id, name])
  @@map("inventory_categories")
}

model InventorySubCategory {
  id            Int               @id @default(autoincrement())
  client_id     Int
  category_id   Int
  name          String            @db.VarChar(255)
  description   String?
  status        String?           @default("Active") @db.VarChar(50)
  created_date  DateTime          @default(now())
  created_by    Int?
  updated_date  DateTime          @default(now()) @updatedAt
  updated_by    Int?
  items         InventoryItem[]
  category      InventoryCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  client        Client            @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser ClientUser?       @relation("SubCatCreatedBy", fields: [created_by], references: [id])
  updatedByUser ClientUser?       @relation("SubCatUpdatedBy", fields: [updated_by], references: [id])

  @@unique([client_id, category_id, name])
  @@map("inventory_sub_categories")
}

model InventoryUnitOfMeasure {
  id            Int             @id @default(autoincrement())
  client_id     Int
  name          String          @db.VarChar(100)
  status        String?         @default("Active") @db.VarChar(50)
  created_date  DateTime        @default(now())
  created_by    Int?
  updated_date  DateTime        @default(now()) @updatedAt
  updated_by    Int?
  baseItems     InventoryItem[] @relation("BaseUOM")
  volumeItems   InventoryItem[] @relation("VolumeUOM")
  weightItems   InventoryItem[] @relation("WeightUOM")
  client        Client          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser ClientUser?     @relation("UOMCreatedBy", fields: [created_by], references: [id])
  updatedByUser ClientUser?     @relation("UOMUpdatedBy", fields: [updated_by], references: [id])

  @@unique([client_id, name])
  @@map("inventory_unit_of_measures")
}

model VatSetting {
  client_id               Int         @id
  is_vat_registered       Boolean?    @default(false)
  updated_date            DateTime    @default(now()) @updatedAt
  updated_by              Int?
  tax_registration_number String?     @db.VarChar(100)
  vat_registered_on       DateTime?   @db.Date
  client                  Client      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  updatedByUser           ClientUser? @relation("VatSettUpdatedBy", fields: [updated_by], references: [id])

  @@map("vat_settings")
}

model VatRate {
  id                      Int                      @id @default(autoincrement())
  client_id               Int
  name                    String                   @db.VarChar(100)
  rate                    Decimal                  @db.Decimal(5, 2)
  status                  String?                  @default("Active") @db.VarChar(50)
  created_date            DateTime                 @default(now())
  created_by              Int?
  updated_date            DateTime                 @default(now()) @updatedAt
  updated_by              Int?
  inventoryItems          InventoryItem[]
  invoiceDetails          InvoiceDetail[]
  quotationDetails        QuotationDetail[]
  recurringInvoiceDetails RecurringInvoiceDetail[]
  deliveryNoteDetails     DeliveryNoteDetail[]
  creditNoteDetails       CreditNoteDetail[]
  client                  Client                   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  createdByUser           ClientUser?              @relation("VatRateCreatedBy", fields: [created_by], references: [id])
  updatedByUser           ClientUser?              @relation("VatRateUpdatedBy", fields: [updated_by], references: [id])

  @@unique([client_id, name])
  @@map("vat_rates")
}

model InventoryItem {
  id                      Int                      @id @default(autoincrement())
  client_id               Int
  item_code               String                   @db.VarChar(50)
  name                    String                   @db.VarChar(255)
  sku                     String?                  @db.VarChar(100)
  description             String?
  uom_id                  Int
  category_id             Int
  sub_category_id         Int?
  sales_rate              Decimal?                 @db.Decimal(18, 3)
  sales_account_id        Int?
  sales_description       String?
  purchase_cost           Decimal?                 @db.Decimal(18, 3)
  reorder_point           Int?                     @default(0)
  purchase_account_id     Int?
  purchase_description    String?
  inventory_account_id    Int?
  stock_in_hand           Decimal?                 @default(0) @db.Decimal(18, 3)
  brands                  String?                  @db.VarChar(255)
  opening_stock           Decimal?                 @default(0) @db.Decimal(18, 3)
  opening_stock_value     Decimal?                 @default(0.000) @db.Decimal(18, 3)
  status                  String?                  @default("Active") @db.VarChar(50)
  warranty_period         String?                  @db.VarChar(100)
  shelf_life              String?                  @db.VarChar(100)
  vendor_id               Int?
  weight_per_unit         Decimal?                 @db.Decimal(18, 3)
  weight_uom_id           Int?
  valuation_method        String?                  @db.VarChar(50)
  volume_per_unit         Decimal?                 @db.Decimal(18, 3)
  volume_uom_id           Int?
  inventory_description   String?
  created_date            DateTime                 @default(now())
  created_by              Int?
  updated_date            DateTime                 @default(now()) @updatedAt
  updated_by              Int?
  deleted_by              Int?
  deleted_date            DateTime?
  vat_rate_id             Int?
  category                InventoryCategory        @relation(fields: [category_id], references: [id])
