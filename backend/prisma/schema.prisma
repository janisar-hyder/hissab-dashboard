}

model ReceiptApplication {
  id             Int     @id @default(autoincrement())
  receipt_id     Int
  invoice_id     Int
  amount_applied Decimal @db.Decimal(18, 3)

  // Relations
  receipt  Receipt @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  invoice  Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("receipt_applications")
}

model CreditNote {
  id                  Int      @id @default(autoincrement())
  client_id           Int
  credit_note_number  String   @db.VarChar(100)
  customer_id         Int
  credit_note_date    DateTime @db.Date
  status              String?  @default("Open") @db.VarChar(50)
  reference_number    String?  @db.VarChar(100)
  sales_person_id     Int?
  currency_id         Int?
  sub_total           Decimal? @default(0.000) @db.Decimal(18, 3)
  total_vat           Decimal? @default(0.000) @db.Decimal(18, 3)
  grand_total         Decimal? @default(0.000) @db.Decimal(18, 3)
  balance             Decimal? @default(0.000) @db.Decimal(18, 3)
  customer_notes      String?  @db.Text
  terms_and_conditions String? @db.Text
  attachments         Json?
  created_date        DateTime @default(now())
  created_by          Int?
  updated_date        DateTime @default(now()) @updatedAt
  updated_by          Int?
  deleted_date        DateTime?
  deleted_by          Int?

  // Relations
  client          Client                  @relation(fields: [client_id], references: [id], onDelete: Cascade)
  customer        Customer                @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  salesPerson     SalesPerson?            @relation(fields: [sales_person_id], references: [id], onDelete: SetNull)
  currency        Currency?               @relation(fields: [currency_id], references: [id], onDelete: SetNull)
  createdByUser   ClientUser?             @relation("CreditNoteCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedByUser   ClientUser?             @relation("CreditNoteUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)
  deletedByUser   ClientUser?             @relation("CreditNoteDeletedBy", fields: [deleted_by], references: [id], onDelete: SetNull)
  details         CreditNoteDetail[]
  applications    CreditNoteApplication[]

  @@unique([client_id, credit_note_number])
  @@map("credit_notes")
}

model CreditNoteDetail {
  id              Int      @id @default(autoincrement())
  credit_note_id  Int
  item_id         Int
  description     String?  @db.Text
  quantity        Decimal  @db.Decimal(18, 3)
  rate            Decimal  @db.Decimal(18, 3)
  vat_rate_id     Int?
  line_total      Decimal  @db.Decimal(18, 3)
  created_date    DateTime @default(now())
  created_by      Int?
  updated_date    DateTime @default(now()) @updatedAt
  updated_by      Int?

  // Relations
  creditNote    CreditNote    @relation(fields: [credit_note_id], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [item_id], references: [id], onDelete: Restrict)
  vatRate       VatRate?      @relation(fields: [vat_rate_id], references: [id], onDelete: SetNull)
  createdByUser ClientUser?   @relation("CNDetCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updatedByUser ClientUser?   @relation("CNDetUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@map("credit_note_details")
}

model CreditNoteApplication {
  id              Int     @id @default(autoincrement())
  credit_note_id  Int
  invoice_id      Int
  amount_applied  Decimal @db.Decimal(18, 3)

  // Relations
  creditNote  CreditNote @relation(fields: [credit_note_id], references: [id], onDelete: Cascade)
  invoice     Invoice    @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("credit_note_applications")
}
