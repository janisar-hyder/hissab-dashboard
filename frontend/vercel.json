{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/hissab-dashboard/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://mytamezy.ap-south-1.elasticbeanstalk.com/api/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
